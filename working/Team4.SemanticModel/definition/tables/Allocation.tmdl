		lineageTag: ba975b47-b38d-41c4-a92f-3e2da0cdae12

	measure Records = COUNTROWS(Allocation)
		formatString: #,0
		displayFolder: 01 Overview
		lineageTag: 45c28f1c-a2a0-442c-b6bf-f6ec598d0444

	/// Unweighted mean of supplied record-level percentages; reconciles to publication where applicable.
	measure 'Mean ROI' = AVERAGE(Allocation[ROI_Pct])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: f03b4ae3-c356-40b4-a660-6f24ec8db927

	/// Unweighted mean of supplied record-level percentages; reconciles to publication where applicable.
	measure 'Mean Forecast Accuracy' = AVERAGE(Allocation[Demand_Forecast_Accuracy_Pct])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: e378bfcc-015e-4039-9081-7ad12cc94a69

	/// Unweighted mean of supplied record-level percentages; reconciles to publication where applicable.
	measure 'Mean Inventory Service' = AVERAGE(Allocation[Inventory_Service_Level_Pct])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: 9aa5b0c3-68a8-4e12-b82f-8aa7cc808b70

	/// Unweighted mean of supplied record-level percentages; reconciles to publication where applicable.
	measure 'Mean Workforce Utilization' = AVERAGE(Allocation[Workforce_Utilization_Pct])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: a3d620ab-62e8-435d-bbaf-decb81c42064

	/// Unweighted mean of supplied record-level percentages; reconciles to publication where applicable.
	measure 'Mean Equipment Utilization' = AVERAGE(Allocation[Equipment_Utilization_Pct])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: b50c3d7f-a587-4481-84ad-310b87f1c2e1

	/// Unweighted mean of supplied record-level percentages; reconciles to publication where applicable.
	measure 'Mean Capacity Coverage' = AVERAGE(Allocation[Capacity_Coverage_Pct])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: fef2a1d6-dd02-4452-b146-1bebc23fbb04

	/// Unweighted mean of supplied record-level percentages; reconciles to publication where applicable.
	measure 'Mean Order Fulfilment' = AVERAGE(Allocation[Order_Fulfilment_Pct])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: 0888ff0a-ed02-4a7f-a995-36af52b8572d

	/// Unweighted mean of supplied record-level percentages; reconciles to publication where applicable.
	measure 'Mean Safety Compliance' = AVERAGE(Allocation[Safety_Compliance_Pct])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: 8a8ef6dd-4e67-4c69-bc74-17b2faae9ff3

	measure 'Mean Resource Risk' = AVERAGE(Allocation[Resource_Risk_Score])
		formatString: 0.0
		displayFolder: 05 Risk and decisions
		lineageTag: ae0c957f-5b1d-4ad8-81ad-36c1b398233e

	measure 'Mean Optimization Priority' = AVERAGE(Allocation[Optimization_Priority_Score])
		formatString: 0.0
		displayFolder: 05 Risk and decisions
		lineageTag: e6a7c791-415d-41b6-bd9d-6c45c250054b

	measure 'Customer Satisfaction' = AVERAGE(Allocation[Customer_Satisfaction_Score])
		formatString: 0.0
		displayFolder: 05 Risk and decisions
		lineageTag: d3b6b386-ab93-4092-b458-cf2b60b9a1e3

	/// Total spend / total allocated budget.
	measure 'Budget Utilization' = DIVIDE([Actual Spend],[Allocated Budget])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: 86a148b9-d001-4e71-b89f-66ceadacf7a5

	/// Operating profit / revenue; not EBITDA.
	measure 'Operating Margin' = DIVIDE([Operating Profit],[Revenue])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: e5c982e1-d443-4dfd-814a-7a9b1bc0ed90

	/// Investment-weighted expected net return; distinct from mean record ROI.
	measure 'Portfolio Expected ROI' = DIVIDE([Expected Return]-[Investment],[Investment])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: cc81f8ae-9514-4089-9ef4-96af70bc3d4f

	/// Allocated / available hours; weighted by available hours.
	measure 'Workforce Utilization' = DIVIDE([Workforce Allocated],[Workforce Available])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: d2355634-660f-43d5-9eca-420b252c1cb1

	/// Allocated / available hours; weighted by available hours.
	measure 'Equipment Utilization' = DIVIDE([Equipment Allocated],[Equipment Available])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: 85bd760d-e296-4fcb-8379-431b4ae48b20

	/// Completed / (completed + delayed) orders.
	measure 'Order Completion Rate' = DIVIDE([Orders Completed],[Orders Completed]+[Orders Delayed])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: 96aabbd2-a700-48b1-bd9a-2a4613a06ab6

	/// Digital / total transactions.
	measure 'Digital Adoption' = DIVIDE(SUM(Allocation[Digital_Transactions]),SUM(Allocation[Total_Transactions]))
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: 3d3e977a-d25a-498f-ade3-b40c74eb03b4

	/// Sum absolute forecast error / actual demand. Existing synthetic forecasts; not new model validation.
	measure 'Demand WAPE' = DIVIDE(SUMX(Allocation,ABS(Allocation[Demand_Units]-Allocation[Forecast_Demand])),[Demand])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 04 Rates
		lineageTag: dfc442ea-39af-46fd-8a85-e7a4ddfffbe9

	measure 'Average CAC' = AVERAGE(Allocation[Customer_Acquisition_Cost_USD])
		formatString: $#,0;($#,0);$0
		displayFolder: 02 Finance
		lineageTag: 2cf7881f-2b8a-46bc-bc17-0dcdda6c1758

	measure 'Average LTV' = AVERAGE(Allocation[Customer_Lifetime_Value_USD])
		formatString: $#,0;($#,0);$0
		displayFolder: 02 Finance
		lineageTag: e2292f09-103d-4b27-adaa-7f503af9a859

	/// Ratio of average supplied LTV to average supplied CAC.
	measure 'LTV to CAC' = DIVIDE([Average LTV],[Average CAC])
		formatString: 0.0"x"
		displayFolder: 02 Finance
		lineageTag: 71037687-32b3-443e-af80-4ff9430f949f

	measure 'Unused Workforce Hours' = [Workforce Available]-[Workforce Allocated]
		formatString: #,0
		displayFolder: 03 Operations
		lineageTag: cfe56f50-301d-4183-97ce-712b00c4dbe5

	measure 'Unused Equipment Hours' = [Equipment Available]-[Equipment Allocated]
		formatString: #,0
		displayFolder: 03 Operations
		lineageTag: 6bf2c04c-f35a-41a1-95e1-bf3014be837d

	/// Sum of positive record-level capacity gaps; avoids netting surplus against unrelated shortages.
	measure 'Capacity Shortfall' = SUMX(Allocation,MAX(0,Allocation[Service_Demand]-Allocation[Service_Capacity]))
		formatString: #,0
		displayFolder: 03 Operations
		lineageTag: ab346929-0e04-49c2-87ad-213685820b7b

	measure 'Review Records' = CALCULATE([Records],KEEPFILTERS(Allocation[Decision_Status] = "Review"))
		formatString: #,0
		displayFolder: 05 Risk and decisions
		lineageTag: 7660f2b0-938a-4eeb-b1ad-f6ab82fcb468

	/// Count of supplied Reallocate labels; no undocumented score threshold inferred.
	measure 'Reallocation Records' = CALCULATE([Records],KEEPFILTERS(Allocation[Decision_Status] = "Reallocate"))
		formatString: #,0
		displayFolder: 05 Risk and decisions
		lineageTag: a6ed9ade-3ed9-4c84-976d-ae469728a7c7

	measure 'Attention Records' = CALCULATE([Records],KEEPFILTERS(Allocation[Decision_Status] <> "Maintain"))
		formatString: #,0
		displayFolder: 05 Risk and decisions
		lineageTag: 123b324f-2676-4cf6-bfae-256bcf6dc16a

	measure 'Attention Budget' = CALCULATE([Allocated Budget],KEEPFILTERS(Allocation[Decision_Status] <> "Maintain"))
		formatString: $#,0;($#,0);$0
		displayFolder: 05 Risk and decisions
		lineageTag: 543a086d-4a56-4468-9851-9f8fe74d95a9

	measure 'Selected Demand Change' = SELECTEDVALUE('Demand Scenario'[Demand Change],0)
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 06 Scenario
		lineageTag: 1c9a9143-d77a-4cbd-bc8a-b6386f8d2e62

	measure 'Scenario Demand' = [Service Demand]*(1+[Selected Demand Change])
		formatString: #,0
		displayFolder: 06 Scenario
		lineageTag: 835edb86-506d-47f9-916c-4e0d035a9e31

	/// Illustrative scenario with fixed capacity. No optimization solver or trained AI model is implied.
	measure 'Scenario Capacity Gap' = SUMX(Allocation,MAX(0,Allocation[Service_Demand]*(1+[Selected Demand Change])-Allocation[Service_Capacity]))
		formatString: #,0
		displayFolder: 06 Scenario
		lineageTag: 68d72b3e-317f-4fd3-9909-0ec9978b4ed0

	measure 'Scenario Coverage' = DIVIDE(SUMX(Allocation,MIN(Allocation[Service_Capacity],Allocation[Service_Demand]*(1+[Selected Demand Change]))),[Scenario Demand])
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: 06 Scenario
		lineageTag: 89ae6ced-7ab2-455a-a433-04e1f42687b3

